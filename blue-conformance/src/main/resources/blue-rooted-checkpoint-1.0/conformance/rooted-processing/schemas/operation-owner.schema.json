{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blue:operation-owner:1.0-draft.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "members",
    "internalEdges"
  ],
  "properties": {
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "documentId",
          "historyBasisIdentity"
        ],
        "properties": {
          "documentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Also NFC, no NUL, at most 512 UTF-8 bytes; checked by constructor."
          },
          "historyBasisIdentity": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "internalEdges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurrenceIdentity",
          "parentDocumentId",
          "sourcePath",
          "childDocumentId",
          "activationGeneration"
        ],
        "properties": {
          "occurrenceIdentity": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "parentDocumentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Also NFC, no NUL, at most 512 UTF-8 bytes; checked by constructor."
          },
          "sourcePath": {
            "type": "string"
          },
          "childDocumentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Also NFC, no NUL, at most 512 UTF-8 bytes; checked by constructor."
          },
          "activationGeneration": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Also <= 9007199254740991."
          }
        }
      },
      "minItems": 0
    }
  }
}
