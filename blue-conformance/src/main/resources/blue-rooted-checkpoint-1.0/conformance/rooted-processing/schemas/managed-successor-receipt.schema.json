{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MANAGED_EPOCH_WITH_REPRESENTATION_SUCCESSOR_RECEIPT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workIdentity",
    "planIdentity",
    "sourceReceiptIdentity",
    "contractsInvocationIdentity",
    "contractsResultIdentity",
    "commitCompanionIdentity",
    "consumerDocumentId",
    "consumerRevisionEpoch",
    "consumerRevisionReceiptIdentity",
    "consumerCommittedBlueId",
    "resultingSourceCursor",
    "successorRepresentationCauseIdentity",
    "resultingRepresentationCursor"
  ],
  "properties": {
    "workIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "planIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceReceiptIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contractsInvocationIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contractsResultIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commitCompanionIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumerDocumentId": {
      "type": "string",
      "minLength": 1
    },
    "consumerRevisionEpoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "consumerRevisionReceiptIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumerCommittedBlueId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}(?:#(?:0|[1-9][0-9]*))?$"
    },
    "resultingSourceCursor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "successorRepresentationCauseIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resultingRepresentationCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorReceiptIdentity",
        "positionIdentity",
        "targetPositionIdentity",
        "nextRevisionReceiptIdentity"
      ],
      "properties": {
        "anchorReceiptIdentity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "positionIdentity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "targetPositionIdentity": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "nextRevisionReceiptIdentity": {
          "type": "null"
        }
      }
    }
  },
  "$comment": "Apply identity/managed_successor_constructors.py for safe portable operands and cursor cross-field constraints. Schema/hash does not authenticate the captured successor or its exact original publication. Numbered receipt retains the unconsumed anchor; successor evidence is future work."
}
