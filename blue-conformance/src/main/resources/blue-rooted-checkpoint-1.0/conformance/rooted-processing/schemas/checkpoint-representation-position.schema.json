{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROOTED_CHECKPOINT_REPRESENTATION_POSITION",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentId",
    "epoch",
    "anchorReceiptIdentity",
    "predecessorPositionIdentity",
    "beforeBlueId",
    "afterBlueId",
    "transitionReceiptIdentity",
    "originalInvocationIdentity",
    "inputClosureIdentity",
    "outputClosureIdentity",
    "commitCompanionIdentity",
    "checkpointReferenceProofIdentity"
  ],
  "properties": {
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "anchorReceiptIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessorPositionIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "beforeBlueId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}(?:#(?:0|[1-9][0-9]*))?$"
    },
    "afterBlueId": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}(?:#(?:0|[1-9][0-9]*))?$"
    },
    "transitionReceiptIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "originalInvocationIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputClosureIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outputClosureIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commitCompanionIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "checkpointReferenceProofIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
