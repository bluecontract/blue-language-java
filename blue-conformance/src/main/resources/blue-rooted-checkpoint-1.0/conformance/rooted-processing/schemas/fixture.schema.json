{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blue:rooted-processing-fixture:1.0-draft.1",
  "title": "Rooted processing fixture \u2014 draft source schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "category",
    "title",
    "kind",
    "requirements",
    "input",
    "expected",
    "verification"
  ],
  "properties": {
    "schema": {
      "const": "blue-rooted-processing-fixture/1.0-draft.1"
    },
    "id": {
      "type": "string",
      "pattern": "^RCP-[A-Z]+-[0-9]{3}$"
    },
    "category": {
      "enum": [
        "SEL",
        "SCOPE",
        "DYN",
        "HIST",
        "WORK",
        "RUN"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "kind": {
      "enum": [
        "selector",
        "safe-window",
        "terminal-progress",
        "graph",
        "graph-generated",
        "dynamic",
        "history",
        "historical-read",
        "position-chain",
        "reaction",
        "runtime"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^RCP-[A-Z]+-[0-9]{2}$"
      }
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "minProperties": 1
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "production",
        "scope",
        "artifactBindingRequired"
      ],
      "properties": {
        "model": {
          "enum": [
            "NOT_RUN",
            "NOT_APPLICABLE"
          ]
        },
        "production": {
          "const": "NOT_RUN"
        },
        "scope": {
          "enum": [
            "ABSTRACT_MODEL",
            "PRODUCTION_ADAPTER_REQUIRED"
          ]
        },
        "artifactBindingRequired": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "runtime"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "isolation",
              "documents",
              "steps",
              "variants"
            ],
            "properties": {
              "isolation": {
                "const": "NEW_REALM"
              },
              "documents": {
                "type": "array"
              },
              "steps": {
                "type": "array",
                "minItems": 1
              },
              "variants": {
                "type": "array"
              }
            }
          },
          "expected": {
            "required": [
              "assertions"
            ],
            "properties": {
              "assertions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/assertion"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "verification": {
            "properties": {
              "scope": {
                "const": "ABSTRACT_MODEL"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual",
        "op"
      ],
      "properties": {
        "actual": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "equals",
            "isTrue",
            "allEqual"
          ]
        },
        "expected": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "equals"
              }
            }
          },
          "then": {
            "required": [
              "expected"
            ]
          }
        }
      ]
    }
  }
}
